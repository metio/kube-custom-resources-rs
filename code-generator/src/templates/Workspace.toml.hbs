[workspace]
members = [
{{#each groups as |group| }}
    "custom-resources/{{group}}",
{{/each}}
]
resolver = "2"
exclude = ["code-generator"]

[workspace.package]
edition = "2021"
authors = ["The kube-custom-resources-rs authors"]
description = "Kubernetes Custom Resource Bindings"
homepage = "https://github.com/metio/kube-custom-resources-rs/"
keywords = ["kubernetes", "custom-resources"]
categories = ["api-bindings"]
license = "0BSD"
repository = "https://github.com/metio/kube-custom-resources-rs"

[workspace.dependencies]
kube = { version = "{{kube_rs_major_version}}", default-features = false, features = ["derive"] }
k8s-openapi = { version = "{{k8s_openapi_crate_version}}" }

[profile.dev]
# Disable settings to speed up builds
debug = false
lto = "off"
incremental = false
strip = "none"
debug-assertions = false
overflow-checks = false
